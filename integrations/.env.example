# Copy to integrations/.env and source it, or export these in your shell.
# Never commit the filled-in file: the target is a real phone number / chat id.

# Where the caption comes from. Local app, or your deployed Replit URL.
AERO_API_BASE=http://127.0.0.1:8000

# Default OpenClaw delivery route (overridable with --channel / --target).
OPENCLAW_CHANNEL=whatsapp
OPENCLAW_TARGET=+910000000000
